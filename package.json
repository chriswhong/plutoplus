{
  "name": "plutoplus",
  "private": true,
  "version": "2.0.0",
  "description": "A clip & ship download tool for NYC MapPLUTO tax lot data. No database: static GeoParquet + DuckDB-WASM.",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chriswhong/plutoplus.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build-pages",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build-data": "scripts/build-data.sh",
    "build-pages": "node --experimental-strip-types --no-warnings scripts/build-pages.ts dist",
    "make-images": "node scripts/make-images.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@protomaps/basemaps": "^5.7.2",
    "fflate": "^0.8.3",
    "maplibre-gl": "^6.18.0",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
